FROM archlinux:latest

# Update package database and install the latest versions of build, test, and static check tools
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
        base-devel \
        cmake \
        git \
        ninja \
        pkgconf \
        qt6-base \
        qt6-declarative \
        qt6-svg \
        md4c \
        syntax-highlighting \
        wayland-protocols \
        gtest \
        libsecret \
        clang \
        dbus \
    && pacman -Scc --noconfirm
