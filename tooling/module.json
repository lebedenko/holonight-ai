{
  "module": "holonight-ai",
  "cpp": true,
  "qml": true,
  "languages": [
    "cpp",
    "qml",
    "python",
    "bash"
  ],
  "dependencies": [
    {
      "module": "holonight-config",
      "package": "HoloNightConfig",
      "source_variable": "HOLONIGHT_CONFIG_SOURCE"
    },
    {
      "module": "holonight-qt",
      "package": "HolonightQt",
      "source_variable": "HOLONIGHT_QT_SOURCE"
    }
  ],
  "qml_modules": [
    "HolonightChat"
  ],
  "wayland": true,
  "external_dependencies": [
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Core",
        "Gui",
        "Quick",
        "Qml",
        "Network",
        "Concurrent",
        "Sql",
        "DBus"
      ]
    },
    {
      "id": "secret",
      "scope": [
        "build"
      ]
    },
    {
      "id": "md4c",
      "scope": [
        "build"
      ]
    },
    {
      "id": "syntax",
      "scope": [
        "build"
      ]
    },
    {
      "id": "compiler",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "cmake",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "ninja",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "pkgconf",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "git",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "python",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "gtest",
      "scope": [
        "test"
      ],
      "targets": [
        "GTest::gmock",
        "GTest::gtest"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "Test"
      ]
    },
    {
      "id": "fonts",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "mime",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "task",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "clang-format",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "clang",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "reuse",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "dbus",
      "scope": [
        "test"
      ]
    },
    {
      "id": "gcovr",
      "scope": [
        "test"
      ],
      "feature": "ENABLE_COVERAGE"
    }
  ],
  "external_features": {
    "ENABLE_COVERAGE": false
  }
}
